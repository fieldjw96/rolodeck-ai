        "profiles_provenance_covers_every_field": {
          "name": "profiles_provenance_covers_every_field",
          "value": "coalesce(\n  provenance ->> 'name' in ('scraped', 'enriched', 'jack')\n  and provenance ->> 'description' in ('scraped', 'enriched', 'jack')\n  and provenance ->> 'sector' in ('scraped', 'enriched', 'jack')\n  and provenance ->> 'stage' in ('scraped', 'enriched', 'jack')\n  and (website is null) = (provenance ->> 'website' is null)\n  and (website is null or provenance ->> 'website' in ('scraped', 'enriched', 'jack'))\n, false)"
        },
        "profiles_sector_is_controlled": {
          "name": "profiles_sector_is_controlled",
          "value": "sector in ('ai-ml', 'developer-tools', 'data-infrastructure', 'saas-enterprise', 'fintech', 'health-bio', 'security', 'hardware-robotics', 'climate-energy', 'consumer-marketplace', 'vertical-saas', 'other')"
