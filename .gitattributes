# Normalise all text files to LF on checkout, so a Windows working copy matches CI.
* text=auto eol=lf

# Captured from the live source with `curl` and committed byte-for-byte, so a parser test
# is a test against the real thing. `core.autocrlf` is on by default on Windows and would
# rewrite every newline on checkout, which is exactly the guarantee these files exist to
# make. `-text` pins them.
db/fixtures/*.html -text
db/fixtures/show-hn-*.json -text
db/fixtures/*.meta.json text
db/fixtures/*.xml -text
# iCalendar mandates CRLF line endings, so for these a rewritten newline is not even cosmetic:
# it is a different document from the one the Source served.
db/fixtures/*.ics -text
