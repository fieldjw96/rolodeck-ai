# Copy to .env.local and fill in from the Supabase dashboard (Project Settings → API keys).
# .env.local is gitignored, and none of this belongs on OneDrive.

# The project URL and its publishable key. Both are browser-safe: the publishable key
# identifies the project, and every query it makes is still subject to RLS. Next inlines
# NEXT_PUBLIC_ variables into the client bundle, which is exactly what these are for.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Bypasses RLS completely. Per CLAUDE.md it is for ingest — and for provisioning the one
# account with `npm run account:provision` — on the server laptop only. It must never reach a
# browser, a client bundle, or OneDrive. Deliberately not NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Optional, and only for running the auth integration tests against a real project rather
# than the in-process stub. Point these at a scratch Supabase project, never at the one
# holding real Profiles: the tests create and delete users through the Admin API.
# SUPABASE_TEST_URL=https://your-scratch-project.supabase.co
# SUPABASE_TEST_PUBLISHABLE_KEY=sb_publishable_...

# Postgres connection string. The app's own reads and writes go through it, as the
# `authenticated` role — see docs/adr/0005 — so it is needed to run the app as well as
# `npm run db:migrate`. Use the pooled connection string from the Supabase dashboard
# (Project Settings → Database). It carries a password: deliberately not NEXT_PUBLIC_, and not
# on OneDrive. The tests need no database at all; they run one in-process.
DATABASE_URL=postgres://...

# Postgres's direct (non-pooled) connection string, which connects as the `postgres`
# superuser and so bypasses RLS completely — DATABASE_URL's `authenticated` role cannot
# write to `profiles` at all, since no insert policy exists for it. Per CLAUDE.md this
# belongs to ingest alone: it is what `npm run ingest:seed` and every other Source connect
# with. Same dashboard page as DATABASE_URL. Deliberately not NEXT_PUBLIC_, and not on
# OneDrive.
SUPABASE_DB_URL=postgres://...

# The user id of the one account, from `npm run account:provision` or the Supabase dashboard
# (Authentication → Users). Ingest stamps it on every Profile it writes. Not a secret, but not
# optional either: a Profile written with the wrong owner is not wrong-looking, it is invisible
# — no RLS policy matches it — and ingest bypasses RLS, so nothing would report it.
ROLODECK_OWNER_ID=00000000-0000-0000-0000-000000000000
